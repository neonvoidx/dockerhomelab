# Copy to .env, restrict its permissions (chmod 600 .env), and fill required values.
# Never put real credentials in this tracked template.
# Single-quote literal credentials, especially values containing dollar signs.

# Deployment identity: preserve this name after the stack is created.
COMPOSE_PROJECT_NAME=homelab
# Match the owner of your application/media files (id -u / id -g).
PUID=1000
PGID=1000
# This sets container timezones; cron uses the Docker host's timezone.
TZ=America/New_York

# DNS and Let's Encrypt. Replace these with your own zone and email.
BASE_DOMAIN_NAME=example.com
EMAIL=you@example.com
# Cloudflare DDNS record to update. An empty value updates the zone apex.
# Point the public service DNS records at your home IP or this record.
SUBDOMAIN=home
# Required for initial migration; may leave .env after successful deployment.
CLOUDFLARE_DNS_API_TOKEN=''
CLOUDFLARE_DDNS_API_KEY=''

# Plex integrations. This URL is reachable on the media Docker network.
PLEX_URL=http://plex:32400
PLEX_TOKEN=''
# Kometa requires a TMDb API key; configure its application YAML as well.
TMDB_API_KEY=''
# Optional Kometa integrations: fill only when enabled in its application config.
MDB_API_KEY=''
TRAKT_CLIENT_ID=''
TRAKT_CLIENT_SECRET=''
# Plex Image Cleanup schedule. Keep it away from Kometa/poster generation runs.
SCHEDULE='08:00|daily'
